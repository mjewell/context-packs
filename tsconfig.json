{
  // Node runs the .ts sources directly, outside node_modules, by stripping their types. So the code uses only
  // TypeScript that can be stripped, and names the .ts file in each import. tsc checks the types, and
  // tsconfig.build.json writes dist/ for the npm package, since Node won't strip types under node_modules.
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "rewriteRelativeImportExtensions": true,
    "types": ["node"],
    // So the tests can import the spec-tree page's comment logic, a .mjs module, with the types TypeScript infers
    // from it.
    "allowJs": true,
    "rootDir": ".",
    "outDir": "dist",
    "noEmit": true
  },
  "include": ["src/**/*.ts", "review/**/*.ts", "skills/spec-tree/scripts/**/*.ts", "tests/**/*.ts"]
}

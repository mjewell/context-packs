{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      // Code, JSON and CSS only. Markdown holds the docs, the skills' prompts and the synced block, whose wording is
      // written by hand, and the YAML is GitHub's workflows.
      "**/*.ts",
      "**/*.js",
      "**/*.mjs",
      "**/*.json",
      "**/*.jsonc",
      "**/*.css",
      // Generated by the sync from context-packs/, so it changes there.
      "!context-packs/gen",
      // A page template with @@name@@ placeholders, which tree_render.ts fills: not HTML until then.
      "!skills/spec-tree/scripts/tree_page.html"
    ]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "javascript": { "formatter": { "quoteStyle": "single" } },
  "linter": {
    "rules": {
      "preset": "recommended",
      "style": {
        // tsconfig's noUncheckedIndexedAccess makes every indexed read possibly undefined, and a ! marks one the code
        // knows is there. Replacing them would guard states the contract rules out.
        "noNonNullAssertion": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["skills/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    // Everything, then node: modules and ./ files taken back out, then a ./ path that climbs out.
                    "group": ["*", "**", "!node:*", "!./**", "./**/../**"],
                    "message": "A skill's scripts import only node: modules and files in the skill's own folder, since an installed skill holds only that folder."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}

{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "findings"
  ],
  "properties": {
    "findings": {
      "type": "array",
      "description": "Every finding of the review, as the pack-findings skill sorts them.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "headline",
          "rules",
          "spots",
          "deliberate",
          "exemplars",
          "take"
        ],
        "properties": {
          "kind": {
            "enum": [
              "deviates",
              "conflicting",
              "uncovered"
            ]
          },
          "headline": {
            "type": "string",
            "description": "The finding in one line."
          },
          "rules": {
            "type": "array",
            "description": "The rule a deviation departs from, the two rules of a conflict, or none for an uncovered choice.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "file",
                "quote",
                "routed"
              ],
              "properties": {
                "file": {
                  "type": "string",
                  "description": "The file holding the rule, from the repo root."
                },
                "quote": {
                  "type": "string",
                  "description": "The rule, quoted."
                },
                "routed": {
                  "type": "boolean",
                  "description": "Whether the rule reached the work: inlined, or in a doc whose when matches it."
                }
              }
            }
          },
          "spots": {
            "type": "array",
            "description": "Where in the head commit the finding applies.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "line",
                "follows"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "line": {
                  "type": "integer",
                  "description": "The line in the file at the head commit."
                },
                "follows": {
                  "type": "boolean",
                  "description": "Whether the spot follows the rule. Always false for an uncovered choice."
                }
              }
            }
          },
          "deliberate": {
            "type": "array",
            "description": "Signs a deviation is deliberate, each quoting its source: a comment at the spot, a condition that sets it apart, or a commit message.",
            "items": {
              "type": "string"
            }
          },
          "exemplars": {
            "type": "array",
            "description": "For an uncovered choice, each way the existing code makes it.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "way",
                "examples"
              ],
              "properties": {
                "way": {
                  "type": "string"
                },
                "examples": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "description": "A file and line, as path:line."
                  }
                }
              }
            }
          },
          "take": {
            "type": "string",
            "description": "What you'd do about it, for the author to accept or overrule."
          }
        }
      }
    }
  }
}
